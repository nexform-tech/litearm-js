{
  "name": "litearm-js",
  "version": "0.1.0",
  "description": "LiteArm 机械臂 JavaScript/TypeScript SDK（浏览器/Node.js）",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/litearm.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "robotics",
    "robot-arm",
    "litearm",
    "zenoh",
    "browser",
    "websocket"
  ],
  "author": "luochun",
  "license": "Proprietary",
  "dependencies": {
    "@eclipse-zenoh/zenoh-ts": "^1.9.0",
    "express": "^5.2.1",
    "protobufjs": "^7.2.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
